# =============================================================================
# niri-ai secrets template
# Copy this to ~/.config/niri/scripts/ai-secrets.env (chmod 600) and fill in
# your real credentials. The install script creates this file for you.
#
# IMPORTANT: never commit the real ai-secrets.env to a repo.
# =============================================================================

# --- Baidu OCR (https://cloud.baidu.com/product/ocr) -------------------------
# API Key (Client ID) and Secret Key (Client Secret) from the Baidu OCR app.
BAIDU_CLIENT_ID="YOUR_BAIDU_CLIENT_ID"
BAIDU_CLIENT_SECRET="YOUR_BAIDU_CLIENT_SECRET"

# --- Agnes LLM (OpenAI-compatible chat completions) --------------------------
# API key from https://api.agnes-ai.cn ; the endpoint/model are preconfigured.
AGNES_API_KEY="YOUR_AGNES_API_KEY"
AGNES_BASE_URL="https://api.agnes-ai.cn/v1"
AGNES_MODEL="agnes-2.5-flash"

# --- Target translation language --------------------------------------------
# Used in the translator system prompt and the user prompt template.
TARGET_LANG="Chinese (Simplified)"
TARGET_CODE="zh-CN"
